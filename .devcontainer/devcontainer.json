{
  "name": "watch-sim",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces",
  "postCreateCommand": "bash /workspaces/watch-sim/tools/codespace-setup.sh",
  "postAttachCommand": "bash /workspaces/watch-sim/tools/start-server.sh",
  "portsAttributes": {
    "8080": { "label": "Watch Simulator", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "ParkerHiggins80/Smartwatch": { "permissions": { "contents": "write" } }
      }
    },
    "vscode": {
      "extensions": ["ms-vscode.cpptools"]
    }
  }
}
